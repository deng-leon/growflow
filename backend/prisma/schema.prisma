generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Strain {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  type         String         @default("photoperiod") // autoflower | photoperiod
  plants       Plant[]
  phasePresets PhasePreset[]
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  @@map("strains")
}

model Plant {
  id          Int                   @id @default(autoincrement())
  name        String
  strainId    Int?
  strain      Strain?               @relation(fields: [strainId], references: [id])
  sourceType  String                @default("seed") // seed | clone
  notes       String?               @default("")
  isActive    Boolean               @default(true)
  areaId      Int?
  area        GrowArea?             @relation(fields: [areaId], references: [id], onDelete: SetNull)
  phases      PlantPhase[]
  events      PlantEvent[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@map("plants")
}

model GrowArea {
  id            Int                   @id @default(autoincrement())
  name          String                @unique
  type          String                @default("tent") // tent | room | outdoor | closet | custom
  description   String?
  isActive      Boolean               @default(true)
  controlPhaseName String?
  lightSchedule String? // "18/6", "12/12", "20/4", "24/0", etc.
  leafOffsetC   Float                 @default(-2)
  roomClimateEntityId String?
  plants        Plant[]
  events        AreaEvent[]
  sensorBindings AreaSensorBinding[]
  actuatorBindings AreaActuatorBinding[]
  actionLogs    ActionLog[]
  sensorReadings SensorReading[]
  phaseSettings AreaPhaseSettings[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@map("grow_areas")
}

model AreaPhaseSettings {
  id                     Int      @id @default(autoincrement())
  areaId                 Int
  area                   GrowArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  phaseName              String
  tempMin                Float?
  tempMax                Float?
  humidityMin            Float?
  humidityMax            Float?
  vpdMin                Float?
  vpdMax                Float?
  lightOnTime            String?
  lightOffTime           String?
  ventilationOnMinutes   Int?
  ventilationOffMinutes  Int?
  fanSchedule            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([areaId, phaseName])
  @@index([areaId])
  @@map("area_phase_settings")
}

enum AreaSensorRole {
  temperature
  humidity
  vpd
  roomTemperature
  roomHumidity
}

model AreaSensorBinding {
  id        Int            @id @default(autoincrement())
  areaId    Int
  area      GrowArea       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  role      AreaSensorRole
  entityId  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([areaId, role])
  @@index([areaId])
  @@map("area_sensor_bindings")
}

model SensorReading {
  id        Int             @id @default(autoincrement())
  areaId    Int
  area      GrowArea        @relation(fields: [areaId], references: [id], onDelete: Cascade)
  role      AreaSensorRole
  value     Float
  at        DateTime

  @@index([areaId, role, at])
  @@index([at])
  @@map("sensor_readings")
}

enum AreaActuatorRole {
  light
  humidifier
  dehumidifier
  ventilation
  fan
}

enum ActuatorAlgorithm {
  hysteresis
  pid
}

enum ActuatorFailSafe {
  hold
  off
  on
}

model AreaActuatorBinding {
  id            Int               @id @default(autoincrement())
  areaId        Int
  area          GrowArea          @relation(fields: [areaId], references: [id], onDelete: Cascade)
  role          AreaActuatorRole
  entityId      String
  speedEntityId String?
  maxSpeedPercent Int              @default(100)
  algorithm     ActuatorAlgorithm @default(hysteresis)
  failSafe      ActuatorFailSafe  @default(off)
  minOnSeconds  Int               @default(60)
  minOffSeconds Int               @default(60)
  kp            Float             @default(0.08)
  ki            Float             @default(0.01)
  kd            Float             @default(0.02)
  windowSeconds Int               @default(60)
  manualUntil   DateTime?
  manual        Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([areaId, role])
  @@index([areaId])
  @@map("area_actuator_bindings")
}

enum ActionSource {
  manual
  controller
}

model ActionLog {
  id        Int               @id @default(autoincrement())
  areaId    Int
  area      GrowArea          @relation(fields: [areaId], references: [id], onDelete: Cascade)
  role      AreaActuatorRole
  entityId  String
  action    String
  reason    String
  source    ActionSource
  createdAt DateTime          @default(now())

  @@index([areaId, createdAt])
  @@map("action_logs")
}

model AreaEvent {
  id        Int      @id @default(autoincrement())
  areaId    Int
  area      GrowArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  type      String   // light_schedule | environment | equipment | note
  title     String
  timestamp DateTime @default(now())
  notes     String?
  data      String?  // JSON für type-spezifische Daten
  source    String   @default("manual") // manual | ha_sensor | ha_mqtt
  createdAt DateTime @default(now())

  @@index([areaId, timestamp])
  @@index([areaId, type])
  @@map("area_events")
}

model PlantPhase {
  id           Int          @id @default(autoincrement())
  plantId      Int
  plant        Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  sortOrder    Int          @default(0)
  name         String
  durationMin  Int          @default(7)
  durationMax  Int          @default(14)
  startDate    DateTime?
  isActive     Boolean      @default(false)
  isCompleted  Boolean      @default(false)
  notes        String?
  vpdMin       Float?
  vpdMax       Float?
  tempMin      Float?
  tempMax      Float?
  humidityMin  Float?
  humidityMax  Float?
  lightOnHours Float?
  events       PlantEvent[]
  createdAt    DateTime     @default(now())

  @@map("plant_phases")
}

model PlantEvent {
  id        Int         @id @default(autoincrement())
  plantId   Int
  plant     Plant       @relation(fields: [plantId], references: [id], onDelete: Cascade)
  phaseId   Int?
  phase     PlantPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  type      String      // watering | observation | training | harvest | transplant
  title     String
  timestamp DateTime    @default(now())
  notes     String?
  data      String?     // JSON für type-spezifische Daten
  createdAt DateTime    @default(now())

  @@map("plant_events")
}

model PhasePreset {
  id           Int      @id @default(autoincrement())
  name         String
  sortOrder    Int      @default(0)
  growType     String   @default("photoperiod")
  sourceType   String   @default("seed")
  durationMin  Int      @default(7)
  durationMax  Int      @default(14)
  vpdMin       Float?
  vpdMax       Float?
  tempMin      Float?
  tempMax      Float?
  humidityMin  Float?
  humidityMax  Float?
  lightOnHours Float?
  description  String?
  strainId     Int?
  strain       Strain?  @relation(fields: [strainId], references: [id], onDelete: Cascade)
  @@unique([name, growType, sourceType, strainId])
  @@map("phase_presets")
}
